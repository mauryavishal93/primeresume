{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/file/d/:shareId/view",
      "destination": "/editor.html?share=:shareId&pdf=1"
    },
    {
      "source": "/api/:path*",
      "missing": [
        {
          "type": "query",
          "key": "__api_path"
        }
      ],
      "destination": "/api/handler?__api_path=:path*"
    }
  ]
}
