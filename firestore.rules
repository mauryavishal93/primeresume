rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/resumes/{resumeId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'state', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.state is map
        && request.resource.data.revision == 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'state', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.state is map
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/preferences/resumeEditor {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastWorkedResumeId'])
        && request.resource.data.lastWorkedResumeId is string
        && request.resource.data.lastWorkedResumeId.size() <= 1500;

      allow delete: if false;
    }

    match /users/{userId}/profile/account {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['mobileNumber', 'photoDataUrl', 'highestEducation', 'company', 'designation', 'updatedAt'])
        && request.resource.data.mobileNumber is string
        && request.resource.data.mobileNumber.size() <= 24
        && request.resource.data.mobileNumber.matches('^[+0-9() .-]*$')
        && request.resource.data.photoDataUrl is string
        && request.resource.data.photoDataUrl.size() <= 140000
        && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$|^$')
        && request.resource.data.highestEducation is string
        && request.resource.data.highestEducation.size() <= 100
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 100
        && request.resource.data.designation is string
        && request.resource.data.designation.size() <= 100
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /users/{userId}/trial/proTemplateDownloads {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 2
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /users/{userId}/billing/{document=**} {
      allow read, write: if false;
    }

    match /billingSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /billingWebhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
